{
    "name": "routegroup/laravel-ing-pay",
    "description": "Laravel integration for the ING Pay payment gateway",
    "keywords": [
        "routegroup",
        "laravel",
        "ing-pay",
        "imoje",
        "payments"
    ],
    "homepage": "https://github.com/routegroup/laravel-ing-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajetan Nobel",
            "email": "k.nobel@routegroup.pl",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/routegroup/php-ing-pay"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/http": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "routegroup/php-ing-pay": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30.5",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^11.0||^10.0||^9.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Routegroup\\IngPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routegroup\\IngPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ],
        "test:lint": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"
        ],
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test:unit": "vendor/bin/pest --ci",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Routegroup\\IngPay\\Laravel\\IngPayServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
